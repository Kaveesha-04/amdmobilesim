# Copy to .env.local, which git ignores, and restart Vite after changing it.

# Where the Signal Receiver runs. This is the default.
# VITE_SIGNAL_RECEIVER_URL=http://localhost:3000

# Your transmitter's calibration, on one line. Flying by transmitter is refused until
# this is set. Read the real values from the Raw column of the transmitter panel, or
# from the receiver's dashboard, while moving each stick to its limits.
#
# All values are in raw transmitter units:
#   min, max   the stick's limits
#   center     where the stick rests (roll, pitch and yaw only)
#   deadband   how far from rest, or from the bottom on throttle, still reads as zero
#   invert     true if the stick moves the opposite way to what you want
#
# Positive roll is right, positive pitch is forward and positive yaw is nose right.
# The numbers below only show the format. They are NOT real transmitter values.
#
# VITE_TRANSMITTER_CALIBRATION={"throttle":{"min":0,"max":100,"deadband":0,"invert":false},"roll":{"min":-100,"max":100,"center":0,"deadband":0,"invert":false},"pitch":{"min":-100,"max":100,"center":0,"deadband":0,"invert":false},"yaw":{"min":-100,"max":100,"center":0,"deadband":0,"invert":false}}
